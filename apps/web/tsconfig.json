{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "incremental": true,
    "paths": {
      "@/*": ["./*"],
      "@mordonezdev/logokit-core": ["packages/core/src/index.ts"]
    }
