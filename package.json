{
  "name": "logokit",
  "private": true,
  "version": "1.0.0",
  "description": "Generate brand lockups from any logo via web, API, or CLI.",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @mordonezdev/logokit-web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @mordonezdev/logokit-core test",
    "test:e2e": "pnpm --filter @mordonezdev/logokit-web test:e2e",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "release:check": "pnpm check",
    "release:publish": "pnpm build && pnpm --filter './packages/*' publish -r --access public --no-git-checks"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mordonez/logokit.git"
  },
  "keywords": [
    "branding",
    "logo",
    "lockup",
    "svg",
    "nextjs",
    "cli"
  ],
  "author": "mordonez",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mordonez/logokit/issues"
  },
  "homepage": "https://github.com/mordonez/logokit#readme",
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^25.6.0",
    "start-server-and-test": "^2.1.2",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
