{
  "name": "@mordonezdev/logokit-core",
  "private": true,
  "version": "1.0.2",
  "description": "Brand-agnostic logo lockup rendering, sanitization, and export pipeline shared by the logokit web app, HTTP API, and CLI.",
  "license": "MIT",
  "author": "mordonez",
  "homepage": "https://github.com/mordonez/logokit#readme",
  "bugs": {
    "url": "https://github.com/mordonez/logokit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mordonez/logokit.git",
    "directory": "packages/core"
  },
  "keywords": [
    "logo",
    "lockup",
    "branding",
    "svg",
    "png",
    "sanitization"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external @fontsource/inter --external @resvg/resvg-js --external dompurify --external image-size --external jsdom --external opentype.js --external zod",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@resvg/resvg-js": "^2.6.2",
    "dompurify": "^3.3.0",
    "image-size": "^2.0.2",
    "jsdom": "^26.1.0",
    "opentype.js": "^1.3.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/geist": "^5.2.8",
    "@fontsource/outfit": "^5.2.8",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@types/jsdom": "^27.0.0",
    "@types/opentype.js": "^1.3.9",
    "typescript": "^6.0.3"
  }
}
